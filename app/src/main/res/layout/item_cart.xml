<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="104dp">
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/item_image"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginStart="16dp"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/cart_item"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.ViewResources.Image"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />
    <TextView
        android:id="@+id/item_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="16dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/cart_item_title"
        android:textAppearance="@style/TextAppearance.ViewResources.Title"
        app:layout_constraintStart_toEndOf="@id/item_image"
        app:layout_constraintEnd_toStartOf="@id/item_price"
        app:layout_constraintTop_toTopOf="parent" />
    <TextView
        android:id="@+id/item_category"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/category"
        android:textAppearance="@style/TextAppearance.ViewResources.Body"
        app:layout_constraintStart_toStartOf="@id/item_title"
        app:layout_constraintEnd_toEndOf="@id/item_title"
        app:layout_constraintTop_toBottomOf="@id/item_title" />
    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/supporting_text"
        android:textAppearance="@style/TextAppearance.ViewResources.Body"
        app:layout_constraintStart_toStartOf="@id/item_title"
        app:layout_constraintEnd_toEndOf="@id/item_title"
        app:layout_constraintTop_toBottomOf="@id/item_category" />
    <TextView
        android:id="@+id/item_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:text="@string/item_price"
        android:textAppearance="@style/TextAppearance.ViewResources.Title"
        android:textColor="?attr/appPrice"
        app:layout_constraintBaseline_toBaselineOf="@id/item_title"
        app:layout_constraintEnd_toEndOf="parent" />
    <com.google.android.material.divider.MaterialDivider
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:dividerColor="?attr/colorOutlineVariant"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
