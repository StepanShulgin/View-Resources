<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:background="?attr/appSurface"
        app:navigationIcon="@drawable/ic_menu"
        app:navigationIconTint="?attr/appOnSurface"
        app:navigationContentDescription="@string/menu"
        app:menu="@menu/profile"
        app:title="@string/profile"
        app:titleCentered="true"
        app:titleTextAppearance="@style/TextAppearance.ViewResources.Title"
        app:titleTextColor="?attr/appOnSurface"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    <LinearLayout
        android:id="@+id/launcher_buttons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/contacts_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/open_contacts" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/cart_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/open_cart" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/signin_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/show_sign_in_dialog" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
